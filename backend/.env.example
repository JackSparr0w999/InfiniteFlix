# Telegram API Credentials (https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Target Channel (@channel_username or numerical ID like -100...)
TELEGRAM_CHANNEL=@your_channel

# Telegram Session String (generated via app/sync/genera_sessione.py)
TELEGRAM_SESSION_STRING=your_string_session_here

# Database & Storage
DATABASE_URL=sqlite:///./data/catalog.db
THUMBNAILS_DIR=./thumbnails

# Streaming & Network
STREAM_CHUNK_SIZE=1048576
CORS_ORIGINS=http://localhost:3000

# TMDB API (Optional: for enhanced metadata & posters)
TMDB_API_KEY=your_tmdb_api_key_here
